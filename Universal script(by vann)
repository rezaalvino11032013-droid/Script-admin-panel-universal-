-- Slider
local function slider(txt,mn,mx,def,cb)
    local c = mk("Frame",{Size=UDim2.new(1,-10,0,60),BackgroundColor3=Color3.fromRGB(35,35,50),BorderSizePixel=0},scroll)
    corner(c)
    local l = lbl(c,txt..": "..def,{Size=UDim2.new(1,-20,0,20),Position=UDim2.new(0,10,0,5),TextXAlignment=Enum.TextXAlignment.Left,Font=Enum.Font.GothamBold})
    local bar = mk("Frame",{Size=UDim2.new(1,-20,0,8),Position=UDim2.new(0,10,0,35),BackgroundColor3=Color3.fromRGB(60,60,80),BorderSizePixel=0},c)
    corner(bar,4)
    local fil = mk("Frame",{Size=UDim2.new((def-mn)/(mx-mn),0,1,0),BackgroundColor3=Color3.fromRGB(100,150,255),BorderSizePixel=0},bar)
    corner(fil,4)
    local dg=false
    local function upd(x)
        local rl = math.clamp((x-bar.AbsolutePosition.X)/bar.AbsoluteSize.X,0,1)
        local v = math.floor(mn+(mx-mn)*rl)
        fil.Size=UDim2.new(rl,0,1,0) l.Text=txt..": "..v cb(v)
    end
    bar.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then dg=true upd(i.Position.X) end end)
    UIS.InputChanged:Connect(function(i) if dg and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then upd(i.Position.X) end end)
    UIS.InputEnded:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then dg=false end end)
end

