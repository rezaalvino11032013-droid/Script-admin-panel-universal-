-- Helper UI
local function mk(cls,props,par)
    local o = Instance.new(cls)
    for k,v in pairs(props) do o[k]=v end
    o.Parent = par
    return o
end
local function corner(o,r) mk("UICorner",{CornerRadius=UDim.new(0,r or 6)},o) end
local function lbl(par,txt,props)
    local l = mk("TextLabel",props or {},par)
    l.Text=txt l.Font=Enum.Font.GothamBold l.TextColor3=Color3.new(1,1,1) l.BackgroundTransparency=1
    return l
end
local function btn(par,txt,props)
    local b = mk("TextButton",props or {},par)
    b.Text=txt b.Font=Enum.Font.GothamBold b.TextSize=13
    b.TextColor3=Color3.new(1,1,1) b.BackgroundColor3=Color3.fromRGB(45,45,60) b.BorderSizePixel=0
    corner(b) return b
end

-- Draggable
local function drag(f, target)
    target = target or f
    local d,ds,dp = false,nil,nil
    target.InputBegan:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
            d=true ds=i.Position dp=f.Position
            i.Changed:Connect(function() if i.UserInputState==Enum.UserInputState.End then d=false end end)
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if d and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then
            local dl=i.Position-ds
            f.Position=UDim2.new(dp.X.Scale,dp.X.Offset+dl.X,dp.Y.Scale,dp.Y.Offset+dl.Y)
        end
    end)
end

-- Floating button (bisa digeser)
