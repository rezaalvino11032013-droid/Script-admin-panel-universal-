-- ESP
local function teamClr(pl)
    if not pl.Team then return Color3.fromRGB(255,255,255) end
    return pl.Team==LP.Team and Color3.fromRGB(0,255,0) or Color3.fromRGB(255,0,0)
end
local function updESP()
    for _,pl in pairs(P:GetPlayers()) do
        if pl==LP then continue end
        local c = pl.Character
        if c and c:FindFirstChild("HumanoidRootPart") then
            if not HL[pl] or not HL[pl].Adornee then
                local h = mk("Highlight",{FillTransparency=1,OutlineTransparency=0,DepthMode=Enum.HighlightDepthMode.AlwaysOnTop,Adornee=c,Parent=game.CoreGui},nil)
                HL[pl]=h
            end
            HL[pl].Adornee=c HL[pl].OutlineColor=teamClr(pl) HL[pl].Enabled=S.ESP
        elseif HL[pl] then HL[pl]:Destroy() HL[pl]=nil end
    end
end
RS.Heartbeat:Connect(function() if S.ESP then updESP() end end)

-- Fly
local flyConn, flyBV, flyBG
local function startFly()
    local c=LP.Character if not c then return end
    local hrp=c:FindFirstChild("HumanoidRootPart") if not hrp then return end
    flyBV=mk("BodyVelocity",{MaxForce=Vector3.new(1e5,1e5,1e5),Velocity=Vector3.zero},hrp)
    flyBG=mk("BodyGyro",{MaxTorque=Vector3.new(1e5,1e5,1e5),P=1e4},hrp)
    flyConn=RS.RenderStepped:Connect(function()
        if not S.Fly then return end
        local md=Vector3.zero
        if UIS:IsKeyDown(Enum.KeyCode.W) then md+=CAM.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.S) then md-=CAM.CFrame.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.A) then md-=CAM.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.D) then md+=CAM.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.Space) then md+=Vector3.new(0,1,0) end
        if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then md-=Vector3.new(0,1,0) end
        if md.Magnitude>0 then md=md.Unit end
        flyBV.Velocity=md*FlySpd flyBG.CFrame=CAM.CFrame
    end)
end
local function stopFly()
    if flyConn then flyConn:Disconnect() flyConn=nil end
    if flyBV then flyBV:Destroy() flyBV=nil end
    if flyBG then flyBG:Destroy() flyBG=nil end
end

-- Noclip
local ncConn
local function startNC()
    ncConn=RS.Stepped:Connect(function()
        if S.Noclip and LP.Character then
            for _,p in pairs(LP.Character:GetDescendants()) do
                if p:IsA("BasePart") then p.CanCollide=false end
            end
        end
    end)
end
local function stopNC()
    if ncConn then ncConn:Disconnect() ncConn=nil end
    if LP.Character then
        for _,p in pairs(LP.Character:GetDescendants()) do
            if p:IsA("BasePart") then pcall(function() p.CanCollide=true end) end
        end
    end
end

-- Speed
local function setSpd(v)
    local c=LP.Character if not c then return end
    local h=c:FindFirstChildOfClass("Humanoid") if h then h.WalkSpeed=v and WalkSpd or 16 end
end

-- Infinite Jump
UIS.JumpRequest:Connect(function()
    if S.InfJump and LP.Character then
        local h=LP.Character:FindFirstChildOfClass("Humanoid")
        if h then h:ChangeState(Enum.HumanoidStateType.Jumping) end
    end
end)

-- Free Cam
local fcConn
local function startFC()
    local c=LP.Character if not c then return end
    local hrp=c:FindFirstChild("HumanoidRootPart") if not hrp then return end
    CamPos=CAM.CFrame OrigCam=CAM.CameraType CAM.CameraType=Enum.CameraType.Scriptable
    local rot=CAM.CFrame local vel=Vector3.zero
    UIS.MouseBehavior=Enum.MouseBehavior.LockCenter
    fcConn=RS.RenderStepped:Connect(function(dt)
        if not S.FreeCam then return end
        local md=Vector3.zero
        if UIS:IsKeyDown(Enum.KeyCode.W) then md+=rot.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.S) then md-=rot.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.A) then md-=rot.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.D) then md+=rot.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.Space) then md+=Vector3.new(0,1,0) end
        if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then md-=Vector3.new(0,1,0) end
        vel = md.Magnitude>0 and md.Unit*CamSpd or vel*0.85
        rot=rot+vel*dt CamPos=CamPos+vel*dt CAM.CFrame=rot
    end)
end
local function stopFC()
    if fcConn then fcConn:Disconnect() fcConn=nil end
    CAM.CameraType=OrigCam UIS.MouseBehavior=Enum.MouseBehavior.Default
    if LP.Character then
        local hrp=LP.Character:FindFirstChild("HumanoidRootPart")
        if hrp then CAM.CFrame=hrp.CFrame end
    end
end

